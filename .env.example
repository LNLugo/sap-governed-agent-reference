# --- SAP Business Accelerator Hub sandbox (Step 0) ---
# Log in at api.sap.com, open any API, click "Show API Key".
SAP_SANDBOX_API_KEY=

# --- SAP AI Core / Generative AI Hub (Step 1) ---
# Copy these from your AI Core service key. The SDK reads them automatically.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=          # service key "url" + /oauth/token
AICORE_BASE_URL=          # service key "serviceurls.AI_API_URL" + /v2
AICORE_RESOURCE_GROUP=default

# Model name exactly as listed in SAP AI Launchpad (generative AI hub > model library)
MODEL_NAME=gpt-4o
